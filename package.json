  },
  "bugs": {
    "url": "https://github.com/barnetshen/dsh-yingma-canvas/issues"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
